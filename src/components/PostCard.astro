---
import { CATEGORIES, type CategoryKey } from '../consts';
import FormattedDate from './FormattedDate.astro';

interface Props {
  id: string;
  title: string;
  description?: string;
  pubDate: Date;
  category: CategoryKey;
  isUpdated?: boolean;
  lastModified?: Date;
}

const { id, title, description, pubDate, category, isUpdated, lastModified } =
  Astro.props;
const cat = CATEGORIES[category];
---

<article class="card">
  <div class="meta">
    <a class={`tag tag--${category}`} href={cat.href}>{cat.label}</a>
    {
      isUpdated && lastModified ? (
        <span class="date">
          更新 <FormattedDate date={lastModified} />
        </span>
      ) : (
        <FormattedDate date={pubDate} />
      )
    }
  </div>
  <h3 class="title">
    <a href={`/posts/${id}/`}>{title}</a>
  </h3>
  {description && <p class="excerpt">{description}</p>}
</article>

<style>
  .card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-bottom: 0.6rem;
    color: var(--ink-faint);
    font-size: 0.85rem;
  }
  .title {
    font-size: 1.35rem;
    margin: 0 0 0.4rem;
    line-height: 1.4;
  }
  .title a {
    color: var(--ink);
    text-decoration: none;
  }
  .title a:hover {
    color: var(--teal);
  }
  .excerpt {
    color: var(--ink-soft);
    margin: 0;
    font-size: 0.98rem;
    overflow-wrap: anywhere;
  }
</style>
