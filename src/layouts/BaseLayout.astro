---
import { SITE } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 頁面型態，供 og:type 使用 */
  type?: 'website' | 'article';
  /** 社群分享顯圖（og:image）；相對路徑會自動轉為絕對網址。預設用首頁大圖。 */
  image?: string;
  /** 結構化資料（JSON-LD）節點陣列；會被包進 schema.org 的 @graph 一起輸出。 */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  type = 'website',
  image = '/hero.jpg',
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title}｜${SITE.title}` : `${SITE.title}｜${SITE.tagline}`;
const base = Astro.site ?? SITE.url;
const canonical = new URL(Astro.url.pathname, base).href;
const ogImage = new URL(image, base).href;
const graph =
  jsonLd && jsonLd.length
    ? JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLd })
    : null;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- 結構化資料 JSON-LD -->
    {graph && <script type="application/ld+json" set:html={graph} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700;900&display=swap"
      rel="stylesheet"
    />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={new URL('rss.xml', Astro.site ?? SITE.url).href}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: absolute;
        left: -999px;
        top: 0;
        background: var(--teal);
        color: #fff;
        padding: 0.6em 1em;
        z-index: 50;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
    </style>
  </body>
</html>
